{
  "name": "tldb",
  "main": "worker/entry.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "TLDB_DB",
      "database_name": "tldb",
      "database_id": "c613c8b1-f181-46e8-9195-2b92de834010"
    }
  ],
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_V1", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    // Cloudflare Turnstile (human verification on login/signup).
    // Create a widget at dash.cloudflare.com → Turnstile, then paste the keys here:
    // "TURNSTILE_SITE_KEY": "0xYOUR_SITE_KEY",
    // "TURNSTILE_SECRET": "0xYOUR_SECRET_KEY"
    // Until then the built-in TEST keys are used: the widget is hidden and
    // verification always passes locally.
  }
}
